# ---- aplicacao ----
NODE_ENV=development
APP_PORT=4000
APP_API_PREFIX=/api
# Usadas para montar links nos e-mails e nas URLs de imagem
APP_SITE_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:4000

# ---- banco ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=red_api
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_LOGGING=false

# ---- autenticacao ----
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
# Validade do link de recuperacao de senha, em minutos
RESET_TOKEN_TTL_MINUTES=60

# ---- cors ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ---- rate limit ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- regras de negocio ----
# Percentual de repasse ao fornecedor por modelo comercial.
SPLIT_ESTOQUE_SUPPLIER=50
SPLIT_CATALOGO_SUPPLIER=65

# ---- e-mail ----
# Sem MAIL_HOST o sistema escreve as mensagens no stdout em vez de enviar.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=RED <nao-responda@redestine.com.br>

# ---- upload de imagens ----
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_MB=8
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif

# ---------------------------------------------------------------- Pagamentos
# `manual` e o modo atual: PIX e boleto conferidos pelo financeiro. Trocar
# para um PSP e mudar esta variavel — nenhum service de dominio e alterado.
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=
PAYMENT_API_URL=
PAYMENT_WEBHOOK_SECRET=
# custodia = a RED recebe o total e repassa apos a conclusao da operacao.
# split = o PSP divide no ato da compra (contradiz o prazo de 48h da regra).
PAYMENT_MODE=custodia
PAYMENT_METHODS=pix,boleto,cartao
PAYMENT_PIX_EXPIRES_MINUTES=60
PAYMENT_BOLETO_DUE_DAYS=3

# ---- preparo do banco no arranque ----
# A API roda migrações e seed sozinha ao subir, e importa o catálogo inicial
# apenas quando não há nenhum ativo. Ver src/config/bootstrap.js.
BOOTSTRAP_DB=true
BOOTSTRAP_CATALOG=true
