# Dependências
node_modules/

# Segredos — o .env nunca entra no repositório.
# O .env.example documenta as variáveis sem expor valores.
.env
.env.*
!.env.example

# Uploads são dados, não código: vivem num volume no servidor.
#
# A barra inicial ancora o padrão na RAIZ. Sem ela, `uploads/` casa com
# QUALQUER diretório de mesmo nome em qualquer nível — e engolia
# `src/features/uploads/`, o que fazia a API subir e morrer no primeiro
# require por módulo inexistente.
/uploads/

# Logs e temporários
*.log
npm-debug.log*
.DS_Store
coverage/
